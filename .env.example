# Verity — variáveis de ambiente
# Filosofia zero-setup: tudo abaixo pode ficar vazio. O app abre e funciona
# em modo demo. Preencher cada variável liga um "upgrade" opcional.

# Banco de dados. Vazio não é permitido — mas o valor padrão já cria um
# SQLite local automaticamente (`npm run db:push`), sem nenhuma configuração.
DATABASE_URL="file:./dev.db"

# Cluster Solana usado para exibir/etiquetar as credenciais na UI.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"

# RPC customizado da Solana. Vazio = usa o RPC público de devnet (mais lento,
# sujeito a rate limit, mas funciona sem nenhuma chave).
NEXT_PUBLIC_SOLANA_RPC=""

# Client ID/Secret do GitHub OAuth App. Vazios = OAuth desativado; o usuário
# vincula o GitHub manualmente digitando o username (sem login real).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Personal Access Token do GitHub. Vazio = chamadas à API pública do GitHub
# sem autenticação (rate limit baixo, ~60 req/h). Preencher aumenta o limite.
GITHUB_TOKEN=""

# Chave secreta (base58) da wallet emissora usada pelo Solana Attestation
# Service. Vazia = attestation cai para o modo "memo" (transação real com
# Memo Program) ou "mock" (assinatura simulada), sempre indicado na UI.
VERITY_ISSUER_SECRET_KEY=""

# Controla o modo de demonstração determinístico (dados plausíveis quando
# uma integração externa não está disponível).
# auto = decide sozinho com base nas variáveis acima | on = força demo | off = força modo real
NEXT_PUBLIC_DEMO_MODE="auto"
