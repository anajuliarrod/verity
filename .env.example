# Verity: variáveis de ambiente
# Filosofia zero-setup: tudo abaixo pode ficar vazio. O app abre e funciona
# em modo demo. Preencher cada variável liga um "upgrade" opcional.

# Banco de dados Postgres (Neon).
# `DATABASE_URL` pode apontar para o pooler; `DIRECT_URL` deve apontar para a conexão direta.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Cluster Solana usado para exibir/etiquetar as credenciais na UI.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"

# RPC customizado da Solana. Vazio = usa o RPC público de devnet (mais lento,
# sujeito a rate limit, mas funciona sem nenhuma chave).
NEXT_PUBLIC_SOLANA_RPC=""

# Client ID/Secret do GitHub OAuth App. Vazios = OAuth desativado; o usuário
# vincula o GitHub manualmente digitando o username (sem login real).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Personal Access Token do GitHub. Vazio = chamadas à API pública do GitHub
# sem autenticação (rate limit baixo, ~60 req/h). Preencher aumenta o limite.
GITHUB_TOKEN=""

# Chave secreta (base58) da wallet emissora usada pelo Solana Attestation
# Service. Vazia = attestation cai para o modo "memo" (transação real com
# Memo Program) ou "mock" (assinatura simulada), sempre indicado na UI.
VERITY_ISSUER_SECRET_KEY=""

# Controla se `npm run db:seed` (e `npm run demo:reset`, que roda
# `prisma db push --force-reset` antes do seed) pode tentar emitir uma
# attestation real na Solana devnet. Vazia (padrão) = seed sempre em modo
# mock, sem gastar SOL e sem gerar assinatura nova. Preencher com "1" faz o
# seed tentar uma emissão real (sas -> memo, conforme `VERITY_ISSUER_SECRET_KEY`),
# gastando SOL de devnet do emissor e gerando uma assinatura nova que invalida
# qualquer assinatura já publicada em documentação ou material de apresentação.
VERITY_SEED_ISSUE_REAL=""

# Controla o modo de demonstração determinístico (dados plausíveis quando
# uma integração externa não está disponível).
# auto = decide sozinho com base nas variáveis acima | on = força demo | off = força modo real
NEXT_PUBLIC_DEMO_MODE="auto"

# URL pública completa da aplicação (com esquema, sem barra no final), usada
# quando um Server Component ou rota de servidor precisa montar uma URL
# absoluta (ex: metadataBase para Open Graph). Opcional: a detecção é
# automática. Em produção na Vercel, `VERCEL_PROJECT_PRODUCTION_URL` (ou
# `VERCEL_URL`) já é injetada sozinha; em desenvolvimento local o padrão é
# `http://localhost:3000`. Preencha esta variável só para sobrescrever a
# detecção automática (ex: domínio customizado atrás de outro proxy).
NEXT_PUBLIC_APP_URL=""

# Segredo usado para assinar (HMAC-SHA256) o cookie de sessão (`src/lib/session.ts`).
# Em dev, se ficar vazio, o app usa um fallback fixo só para não travar o zero-setup.
# Esse fallback é público (está neste repositório) e por isso NUNCA deve ser usado
# em produção: com ele, qualquer pessoa poderia forjar a sessão de qualquer usuário.
# Em produção (NODE_ENV=production) o app falha explicitamente se esta variável
# estiver vazia. Gere um valor real com:
#   openssl rand -hex 32
VERITY_SESSION_SECRET=""
